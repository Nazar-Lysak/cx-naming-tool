{
  "name": "naming-tool-widget",
  "cdn-link": "https://nazar-lysak.github.io/cx-naming-tool/cdn/namingToolWidget.iife.js",
  "cdn-use-demo": "https://nazar-lysak.github.io/cx-naming-tool-cdn/index.html",
  "standalone-link": "https://nazar-lysak.github.io/cx-naming-tool/standalone/",
  "demo-link": "https://nazar-lysak.github.io/cx-naming-tool/demo/index.html",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "build:cdn": "vite build --config vite-config/vite.cdn.config.ts",
    "build:standalone": "vite build --config vite-config/vite.standalone.config.ts",
    "build:demo": "vite build --config vite-config/vite.demo.config.ts",
    "build:all": "npm run build:cdn & npm run build:standalone & npm run build:demo & wait",
    "preview:cdn": "serve . -p 3000",
    "clean": "rm -rf dist",
    "deploy": "npm run build:all && gh-pages -d dist"
  },
  "dependencies": {
    "html-react-parser": "^5.2.17",
    "motion": "^12.34.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-share": "^5.2.2",
    "styled-components": "^6.3.9",
    "swiper": "^12.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
